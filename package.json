{
  "name": "cheese-chase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art": "node tools/process-art.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:assets": "capacitor-assets generate --ios --iconBackgroundColor #4aa8ec --splashBackgroundColor #4aa8ec"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "sharp": "^0.32.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/fredoka": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.4"
  }
}
