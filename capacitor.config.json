{
  "appId": "com.orhunyaman.cheesechase",
  "appName": "Cheese Chase",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#4aa8ec",
    "loggingBehavior": "debug"
  },
  "plugins": {
